# ==============================================================================
# Spark release and deploy configuration (.env)
# ==============================================================================
# Copy this file to .env and fill in the values. The .env file is git-ignored.
# Never commit real values, and never print them in logs.

# --- Self-hosted upload (HTTP) ---
# Base URL of the distribution server, for example http://<server-ip>:<port>
SERVER_URL=
# Upload endpoint (optional, defaults to SERVER_URL + /upload)
UPLOAD_ENDPOINT=
# Bearer token that the server expects (must match the uploader configuration)
UPLOAD_TOKEN=
# Deployment method: http (default), ssh, or github
DEPLOY_METHOD=http

# --- GitHub Releases deployment (used when DEPLOY_METHOD=github) ---
# GitHub repository in format owner/repo (e.g. leonardo-mais/my-app)
GITHUB_REPO=
# Personal Access Token with repo scope (required if repository is private or for automated release publication)
GITHUB_TOKEN=

# --- Remote deployment over SSH (rsync / scp), used when DEPLOY_METHOD is not http ---
# Hostname or IP address of the server
REMOTE_HOST=
# SSH user on the remote server
REMOTE_USER=
# Remote folder that serves the dist/ files
REMOTE_PATH=
# SSH port (default: 22)
REMOTE_PORT=22

# --- Release signing (optional) ---
# Required for release builds (./gradlew assembleRelease): the build fails if the keystore or its passwords are missing.
# There is no fallback to the debug key.
# KEYSTORE_PATH=/path/to/release-key.jks
# KEYSTORE_PASSWORD=your_keystore_password
# KEY_ALIAS=your_key_alias
# KEY_PASSWORD=your_key_password
