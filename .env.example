# ==============================================================================
# AuraStanza / Spark! Release & Deploy Configuration (.env)
# ==============================================================================
# Copia questo file in .env per abilitare la sincronizzazione automatica remota.

# --- Parametri Deploy Remoto (rsync / scp) ---
# Indirizzo IP o hostname del server (es. 192.168.1.100 o vps.tuodominio.it)
REMOTE_HOST=

# Utente SSH sul server remoto (es. root, ubuntu, debian)
REMOTE_USER=

# Percorso cartella remota montata su Docker (es. /opt/aurastanza-releases/data/dist)
REMOTE_PATH=

# Porta SSH (default: 22)
REMOTE_PORT=22

# --- Configurazione Firma APK Personalizzata (Opzionale) ---
# Se non specificati, viene utilizzato il debug keystore con firma v2/v3 automatica.
# KEYSTORE_PATH=/percorso/keystore.jks
# KEYSTORE_PASSWORD=la_tua_password
# KEY_ALIAS=il_tuo_alias
# KEY_PASSWORD=la_password_della_chiave
